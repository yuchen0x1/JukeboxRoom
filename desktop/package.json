{
  "name": "jukeboxroom-desktop",
  "productName": "JukeboxRoom",
  "version": "0.0.17",
  "private": true,
  "description": "JukeboxRoom 桌面版（内置本地服务端）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check:icon": "node ../scripts/check-desktop-icon.mjs",
    "predist": "node ../scripts/gen-desktop-icon.mjs && npm run check:icon",
    "postdist": "node ../scripts/check-desktop-icon.mjs --artifacts",
    "dist": "electron-builder --win nsis",
    "test:updater": "node --test updater.test.js network.test.js ipc-security.test.js scripts/write-checksums.test.cjs scripts/afterPack.test.cjs"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.openmusic.app",
    "productName": "JukeboxRoom",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "network.js",
      "preload.js",
      "ipc-security.js",
      "updater.js",
      "package.json",
      "build/icon.png",
      "build/JukeboxRoom.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yuchen0x1",
        "repo": "JukeboxRoom",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=6.0",
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env",
          "!data/**",
          "!downloads/**"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/JukeboxRoom.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": true,
      "artifactName": "jukeboxroom-desktop-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "jukeboxroom-desktop-setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "^6.8.11"
  }
}
