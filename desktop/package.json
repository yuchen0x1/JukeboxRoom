{
  "name": "jukeboxroom-desktop",
  "productName": "JukeboxRoom",
  "version": "0.0.13",
  "private": true,
  "description": "JukeboxRoom 桌面版（内置本地服务端）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.openmusic.app",
    "productName": "JukeboxRoom",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "../release/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/JukeboxRoom.ico"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env",
          "!data/**",
          "!downloads/**"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/JukeboxRoom.ico",
      "signAndEditExecutable": false,
      "artifactName": "jukeboxroom-desktop-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "jukeboxroom-desktop-setup-${version}-${arch}.${ext}"
    }
  }
}
