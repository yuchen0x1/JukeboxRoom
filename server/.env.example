PORT=4000

# 可选：将 JSON 持久化文件放到独立磁盘目录；不设置则使用 server/data
# OPENMUSIC_DATA_DIR=/var/lib/openmusic/data

# 可选：曲库文件变化后自动重新扫描（默认关闭）
# LIBRARY_WATCH_ENABLED=1
# MUSIC_LIBRARY_PATHS=/var/lib/openmusic/music

# 可选：音乐源连续失败时短时熔断，冷却后自动恢复探测
# MEDIA_HEALTH_FAILURE_THRESHOLD=5
# MEDIA_HEALTH_FAILURE_WINDOW_MS=60000
# MEDIA_HEALTH_COOLDOWN_MS=30000

# 在线更新检查（仅读取 GitHub 稳定 Release）
# UPDATE_REPOSITORY=yuchen0x1/JukeboxRoom
# UPDATE_RELEASE_API_URL=https://api.github.com/repos/yuchen0x1/JukeboxRoom/releases/latest
# UPDATE_GITHUB_TOKEN=（可选；GitHub API 限流时填写只读令牌）
# UPDATE_CHANNEL=github
# APP_VERSION=0.0.14

# 生产环境必填：允许访问的前端 Origin，多个用英文逗号分隔（必须 https）
CLIENT_URL=https://your-domain.com

# 生产环境必填：至少 32 个字符的随机值，用于签名浏览器会话 ID；重启后不要变化
CLIENT_ID_SECRET=replace_with_a_random_secret_at_least_32_characters

# 生产环境必填：至少 32 个字符的另一段随机值，用于签名平台账号 JWT；重启后不要变化
AUTH_JWT_SECRET=replace_with_another_random_secret_at_least_32_characters

# 平台账号访问令牌与刷新令牌有效期（毫秒；刷新令牌默认 30 天）
# AUTH_ACCESS_TTL=86400000
# AUTH_REFRESH_TTL=2592000000

# 首次启动引导超级管理员（两项必须同时配置；创建成功后可移除或保留）
# ADMIN_INIT_USERNAME=admin
# ADMIN_INIT_PASSWORD=请替换为至少 8 位随机密码

# 单 IP 同时在线 Socket 数上限（进程内；多实例仍需 Redis 级限流）
# MAX_CONCURRENT_SOCKETS_PER_IP=50

# 单 IP 每分钟 API 请求上限（只统计 /api/*，静态资源与健康检查不计入）
# 默认 240；反向代理后请确认 TRUST_PROXY=1，否则所有用户共用一个 IP 桶
# HTTP_API_RATE_LIMIT_PER_MIN=240

# 宝塔/Nginx 反代后启用：仅当反代会正确覆盖 X-Forwarded-For 时设为 1
# 未开启时应用看到的客户端 IP 均为回环地址，限流与并发上限会退化为全站共用一个桶
# TRUST_PROXY=1

# 运行可观测性：启用后提供 /metrics
# 注意：METRICS_ENABLED=1 但未设置 METRICS_TOKEN 时 /metrics 直接返回 404，
# 不会在无鉴权情况下公开运行指标（房间数、连接数、错误率等）。
# METRICS_ENABLED=0
# METRICS_TOKEN=replace_with_a_long_random_token



# Meting API（网易云 + QQ 播放/歌词/封面/歌单导入）
# 公网部署优先使用可校验证书的 HTTPS 上游；本机自托管时需显式允许私有上游。

METING_API_URL=http://localhost:3000
# 仅本机/内网自托管 Meting 时开启；不要将此项作为公网生产默认值
# ALLOW_PRIVATE_UPSTREAMS=1

METING_API_AUTH=your_apikey_here

# 媒体代理额外允许的 CDN 域名（可选；逗号/空格/分号分隔，支持 *.example.com）
# 默认只允许网易云、QQ 音乐、酷狗、汽水/字节系已知 CDN；自建或新增音源 CDN 需显式加入。
# MEDIA_PROXY_ALLOWED_HOSTS=cdn.example.com,*.music.example.org



# 迟言 API（酷狗搜索/播放）

CYAPI_BASE=https://cyapi.top/API

CYAPI_KEY=your_apikey_here



# 歌词备用（按歌名）

VMY_LRC_URL=https://api.52vmy.cn/api/music/lrc



# Redis 房间持久化 + 点歌热榜（可选，不配置则使用内存，重启后数据丢失）

# 方式一：连接串（适合无账号或密码已写在 URL 里）

# REDIS_URL=redis://127.0.0.1:6379/0



# 方式二：分项配置（账号密码没有就不填）

# REDIS_HOST=127.0.0.1

# REDIS_PORT=6379

# REDIS_USERNAME=

# REDIS_PASSWORD=

# REDIS_DB=0

# 七牛云 OSS（聊天图片，可选；不配置则无法发送图片）

# QINIU_ACCESS_KEY=

# QINIU_SECRET_KEY=

# QINIU_BUCKET=

# QINIU_DOMAIN=https://cdn.example.com

# 存储区域：z0 华东 | z1 华北 | z2 华南 | na0 北美 | as0 东南亚

# QINIU_ZONE=z0

# 接口盒子 - 聊天表情包搜索（可选；不配置则隐藏搜索入口）
# APIHZ_IMG_ID=
# APIHZ_IMG_KEY=

# ===== 音源登录/搜索（2026-11 新增）=====
# QQ 音乐等搜索的备用 Meting 源（服务器不支持 type=search 时自动走它）；需携带完整端点路径
# METING_SEARCH_API_URL=https://api.i-meto.com/meting/api
# 会话签名密钥：不配置则每次重启随机生成，所有浏览器登录态失效（生产必须固定）
# CLIENT_ID_SECRET=change-me-to-a-long-random-string
# 搜索结果排序：房主已登录的平台（QQ音乐等）排前，未登录的排后（自动，无需配置）
# GitHub 只读令牌：更新检查走认证请求，避免匿名 API 限流（可选；public_repo 权限即可）
# UPDATE_GITHUB_TOKEN=

