{
  "name": "openmusic",
  "version": "0.0.1",
  "description": "OpenMusic - Multiplayer Music Room",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "npm run test:all",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:all": "npm run test:server && npm run test:client",
    "check": "npm run test:all && npm run build && npm run audit:prod",
    "check:health": "node scripts/health-check.mjs",
    "audit:prod": "npm audit --omit=dev && npm audit --prefix server --omit=dev && npm audit --prefix client --omit=dev",
    "start": "npm run start --prefix server",
    "package:build": "node scripts/package-build.mjs",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "cap:sync:android": "npm run cap:sync:android --prefix client",
    "cap:sync:ios": "npm run cap:sync:ios --prefix client",
    "cap:open:android": "npm run cap:open:android --prefix client",
    "cap:open:ios": "npm run cap:open:ios --prefix client",
    "cap:run:android": "npm run cap:run:android --prefix client",
    "cap:run:ios": "npm run cap:run:ios --prefix client",
    "cap:build:apk": "npm run cap:build:apk --prefix client",
    "desktop:dev": "npm run build && npm run start --prefix desktop",
    "desktop:build": "npm run build && npm run dist --prefix desktop"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
