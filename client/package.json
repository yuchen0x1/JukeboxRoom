{
  "name": "openmusic-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "preview": "vite preview",
    "cap:sync": "node scripts/cap-sync.mjs",
    "cap:sync:android": "node scripts/cap-sync.mjs android",
    "cap:sync:ios": "node scripts/cap-sync.mjs ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync:android && npx cap run android",
    "cap:run:ios": "npm run cap:sync:ios && npx cap run ios",
    "cap:build:apk": "node scripts/build-android-apk.mjs debug",
    "cap:build:apk:release": "node scripts/build-android-apk.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.6.8",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-window": "^1.8.10",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@types/react-window": "^1.8.8"
  },
  "overrides": {
    "nanoid": "3.3.18"
